---
# Generated from _data/homepage.yml and _projects/. Don't edit the output; edit those instead.
layout: null
sitemap: false
---
{%- capture newline %}
{% endcapture -%}
{%- assign entries = "" | split: "" -%}
{%- assign slugs = site.data.homepage -%}
{%- for project in site.projects -%}
	{%- assign slug = project.url | remove: "/" -%}
	{%- unless slugs contains slug -%}{%- assign slugs = slugs | push: slug -%}{%- endunless -%}
{%- endfor -%}
{%- for slug in slugs -%}
	{%- assign project_url = "/" | append: slug | append: "/" -%}
	{%- assign project = site.projects | where: "url", project_url | first -%}
	{%- if project -%}
		{%- capture title -%}{{ project.home.title | default: project.title }}{{ newline }}\ {{ project.home.subtitle }}{{ newline }}{{ project.home.year | default: project.year }}{%- endcapture -%}
		{%- capture entry -%}
		{
			"projectID": {{ project.number | append: "" | jsonify }},
			"title": {{ title | jsonify }},
			"url": {{ "https://bensnell.io/" | append: slug | jsonify }}
			{%- unless site.data.homepage contains slug -%},
			"unlisted": true
			{%- endunless %}
		}
		{%- endcapture -%}
		{%- assign entries = entries | push: entry -%}
	{%- endif -%}
{%- endfor -%}
{
	"homeFolderName": "_assets/home",
	"imgExt": "jpg",
	"projects": [{{ entries | join: "," }}
	]
}
